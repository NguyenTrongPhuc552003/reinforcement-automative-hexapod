#!/bin/bash
set -e

echo "Configuring Hexapod Robot Control System..."

# Set proper permissions for executables
echo "Setting executable permissions..."
chmod +x /usr/local/bin/hexapod_app 2>/dev/null || true
chmod +x /usr/local/bin/test_* 2>/dev/null || true
chmod +x /opt/hexapod/install.sh 2>/dev/null || true
chmod +x /opt/hexapod/monitor.sh 2>/dev/null || true

# Create log directory
mkdir -p /var/log/hexapod
chmod 755 /var/log/hexapod

# Install and enable systemd service
if command -v systemctl &> /dev/null; then
    echo "Installing hexapod systemd service..."
    systemctl daemon-reload
    systemctl enable hexapod.service
    
    # Start service with delay to ensure proper initialization
    echo "Starting hexapod autonomous service..."
    sleep 1
    systemctl start hexapod.service
    
    # Verify service is running
    sleep 3
    if systemctl is-active --quiet hexapod.service; then
        echo "✓ Hexapod autonomous service is running"
        echo "✓ Robot will automatically start moving and avoiding obstacles!"
    else
        echo "⚠ Service start may need more time. Check with: systemctl status hexapod"
        echo "Manual restart: systemctl restart hexapod"
    fi
else
    echo "Systemd not available - manual start required"
fi

echo "Hexapod Robot Control System installed successfully!"
echo ""
echo "AUTONOMOUS MODE ACTIVE!"
echo "   Hexapod will automatically start moving and avoiding obstacles"
echo ""
echo "Control Commands:"
echo "  systemctl status hexapod       - Check robot status"
echo "  systemctl stop hexapod         - Stop robot movement"  
echo "  systemctl restart hexapod      - Restart robot"
echo "  journalctl -u hexapod -f       - View live robot logs"
echo ""
echo "Manual Mode:"
echo "  sudo systemctl stop hexapod    - Stop autonomous mode first"
echo "  sudo hexapod_app               - Run manually"
echo ""
echo "Robot is now operational and will start moving automatically!"

exit 0
